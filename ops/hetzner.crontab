# Hetzner VPS crontab (Phase 2). CHỈ các skill không cần Chrome/Facebook.
# Cài: crontab ops/hetzner.crontab   (sau khi clone repo vào /opt/sublet-skills, cài claude CLI hoặc codex, set env)
# TZ=Europe/Amsterdam
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
SUBLET_RUNNER=claude
SUBLET_IMAP_USER=
SUBLET_IMAP_PASS=

# Active sublet workflow is manual on Kien's Mac browser panel; no sublet job runs here.
30 23 * * *   cd /opt/sublet-skills && ops/run_skill.sh backup
